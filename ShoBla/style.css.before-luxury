* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --cream: #f4e8d5;
    --cream-soft: #fbf4e7;
    --maroon: #702638;
    --maroon-dark: #4e1b29;
    --gold: #aa8451;
    --ink: #39242a;
    --muted: #74636a;
    --line: rgba(78, 27, 41, 0.14);
    --white: #fffdf8;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    background: var(--cream);
    color: var(--ink);
    font-family: Georgia, "Times New Roman", serif;
}

/* PAGE 1 */
.outer {
    width: min(1280px, 92%);
    margin: auto;
    padding: 72px 20px 34px;
    text-align: center;
}

.top-row {
    width: 270px;
    height: 110px;
    object-fit: contain;
}

.outer h1 {
    margin-top: 24px;
    color: var(--maroon-dark);
    font-size: 5rem;
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -2px;
}

.middle {
    width: min(1320px, 94%);
    height: 650px;
    margin: 34px auto 68px;
    display: flex;
    gap: 15px;
}

.gallery-img {
    flex: 1;
    min-width: 0;
    height: 100%;
    border-radius: 4px;
    background: url("image.png") center / cover no-repeat;
    box-shadow: 0 18px 42px rgba(78, 27, 41, 0.14);
}

.description {
    width: min(1050px, 90%);
    margin: 0 auto 125px;
    padding: 42px 58px;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--cream-soft);
    box-shadow: 0 12px 28px rgba(78, 27, 41, 0.05);
    color: var(--muted);
    font-size: 16px;
    line-height: 1.9;
    text-align: center;
}

/* SHARED HEADINGS */
.section-heading {
    max-width: 900px;
    margin: 0 auto 58px;
    text-align: center;
}

.section-heading > p:first-child {
    margin-bottom: 14px;
    color: var(--maroon);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 4px;
}

.section-heading h2 {
    color: var(--maroon-dark);
    font-size: 4rem;
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -1.5px;
}

.section-heading > span {
    display: block;
    width: 58px;
    height: 2px;
    margin: 23px auto;
    background: var(--gold);
}

.section-intro {
    max-width: 760px;
    margin: auto;
    color: var(--muted);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    line-height: 1.8;
}

/* PAGE 2 */
.hotel-rooms {
    padding: 125px 4% 140px;
    background: var(--cream);
    border-top: 1px solid var(--line);
}

.room-grid {
    width: min(1280px, 100%);
    margin: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 38px;
}

.room-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--cream-soft);
    box-shadow: 0 18px 38px rgba(78, 27, 41, 0.10);
}

.room-card img {
    display: block;
    width: 100%;
    height: 420px;
    object-fit: cover;
}

.room-info {
    padding: 30px 32px 24px;
    text-align: center;
}

.room-info h3 {
    margin-bottom: 12px;
    color: var(--maroon);
    font-size: 32px;
    font-weight: 500;
}

.room-info > p {
    min-height: 52px;
    color: var(--muted);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 14px;
    line-height: 1.7;
}

.room-details {
    margin-top: 20px;
    padding: 13px 10px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 24px;
    border: 1px solid rgba(78, 27, 41, 0.08);
    border-radius: 3px;
    background: #efe0ca;
    color: var(--maroon-dark);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 11px;
}

/* PAGE 3 */
.cottages {
    padding: 125px 4% 145px;
    background: var(--cream);
    border-top: 1px solid var(--line);
}

.cottage-grid {
    width: min(1280px, 100%);
    margin: auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
}

.cottage-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--cream-soft);
    box-shadow: 0 16px 34px rgba(78, 27, 41, 0.09);
}

.cottage-card img {
    display: block;
    width: 100%;
    height: 285px;
    object-fit: cover;
}

.cottage-info {
    padding: 25px 22px 0;
}

.cottage-info h3 {
    margin-bottom: 11px;
    color: var(--maroon);
    font-size: 22px;
    font-weight: 500;
}

.cottage-info > p {
    min-height: 46px;
    color: var(--muted);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
    line-height: 1.7;
}

.cottage-details {
    margin: 20px -22px 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    background: #f2e6d2;
}

.cottage-details span {
    padding: 12px 5px;
    color: var(--maroon-dark);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 11px;
    text-align: center;
    white-space: nowrap;
}

.cottage-details span + span {
    border-left: 1px solid var(--line);
}

/* PAGE 4 */
.dining {
    padding: 125px 4% 145px;
    background: var(--cream);
    border-top: 1px solid var(--line);
}

.dining-grid {
    width: min(1280px, 100%);
    margin: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 38px;
}

.dining-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--cream-soft);
    box-shadow: 0 18px 38px rgba(78, 27, 41, 0.10);
}

.dining-card img {
    display: block;
    width: 100%;
    height: 390px;
    object-fit: cover;
}

.dining-info {
    padding: 29px 30px 34px;
    text-align: center;
}

.dining-info h3 {
    margin-bottom: 11px;
    color: var(--maroon);
    font-size: 31px;
    font-weight: 500;
}

.dining-info p {
    max-width: 590px;
    margin: auto;
    color: var(--muted);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 14px;
    line-height: 1.75;
}

/* PAGE 5 */
.multiplex {
    padding: 115px 4% 135px;
    background: var(--cream);
    border-top: 1px solid var(--line);
    text-align: center;
}

.multiplex .section-heading {
    max-width: 850px;
    margin-bottom: 55px;
}

.multiplex .section-heading h2 {
    font-size: 3.8rem;
}

.multiplex .section-heading > span {
    margin: 19px auto 18px;
}

.multiplex-gallery {
    width: min(1080px, 100%);
    margin: 0 auto 38px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 15px;
}

.multiplex-gallery img {
    display: block;
    width: 100%;
    aspect-ratio: 0.72;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 5px;
    box-shadow: 0 12px 26px rgba(78, 27, 41, 0.09);
}

.multiplex-copy {
    width: min(980px, 100%);
    margin: auto;
    text-align: center;
}

.multiplex-copy > p {
    margin: auto;
    color: var(--muted);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 14px;
    line-height: 1.85;
}

.multiplex-button {
    display: inline-block;
    margin-top: 27px;
    padding: 13px 30px;
    border: 1px solid var(--maroon);
    border-radius: 30px;
    background: var(--maroon);
    color: #fffaf1;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
    text-decoration: none;
}
